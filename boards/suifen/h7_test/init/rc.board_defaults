#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------


# 覆盖默认的参数文件路径 (通常是 /fs/mtd_params)
# 将其指向 SD 卡 (通常挂载在 /fs/microsd)
set PARAM_FILE /fs/microsd/params
set PARAM_BACKUP_FILE /fs/microsd/parameters_backup.bson

# 关键步骤：告诉 param 系统使用新路径
param select $PARAM_FILE

# 如果里面已经有参数，重新导入一次
if [ -f $PARAM_FILE ]
then
	param import
fi

# 默认启用 DShot600 (值为 -3)
# 注意：在 PX4 v1.14+ 版本中，PWM_MAIN_RATE 已废弃，
# 改为使用 PWM_MAIN_TIMx 单独配置每个定时器组的协议与速率。
# TIM0 (Timer5, Ch1-4) -> DShot600
param set-default PWM_MAIN_TIM0 -3
# # TIM1 (Timer4, Ch5-6) -> DShot600
# param set-default PWM_MAIN_TIM1 -3
# # TIM2 (Timer1, Ch7-8) -> DShot600
# param set-default PWM_MAIN_TIM2 -3

param set-default BAT1_V_DIV 18.1
param set-default BAT2_V_DIV 18.1

param set-default BAT1_A_PER_V 36.367515152
param set-default BAT2_A_PER_V 36.367515152

# # MAVLink 配置
# # MAV_0_CONFIG (Telem 1) -> /dev/ttyS5
# param set-default MAV_0_CONFIG 102
# param set-default MAV_0_MODE 0

# # MAV_1_CONFIG (Telem 2) -> /dev/ttyS3 (常用于机载计算机)
# param set-default MAV_1_CONFIG 101
# param set-default MAV_1_MODE 2

# XRCE-DDS (ROS2) 配置 - 如果使用 ROS2，取消注释并设置端口
# param set-default UXRCE_DDS_CFG 103  # Use TEL3 (/dev/ttyS1)
