#!/bin/sh
#
# PX4 FMUv6C specific board sensors init
#------------------------------------------------------------------------------
board_adc start


# bmi088 -A -s start -b 1
# bmi088 -G -s start -b 1

icm42688p -R 12 -S start -b 1

# Barometer on I2C4
ms5611 -X -b 4 -a 0x77 -T 5607 start

ms53l2m start -d /dev/ttyS5 -R 25

mlx90393 -X -b 1  start
