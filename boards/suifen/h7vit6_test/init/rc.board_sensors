#!/bin/sh
#
# PX4 FMUv6C specific board sensors init
#------------------------------------------------------------------------------
board_adc start

# Internal SPI BMI088 accel/gyro on SPI1 (Bus 1)
bmi088 -A -s -b 1 start
bmi088 -G -s -b 1 start

# Internal SPI ICM42688p on SPI1 (Bus 1)
icm42688p -s -b 1 start

# Pressure sensor on I2C1 (Bus 1). Assuming MS5611 as per previous config hints, but MD just says "Barometer"
# If fail, it won't crash, just complain.
ms5611 -X -b 1 start

# Magnetometer on I2C1 (Bus 1)
ist8310 -X -b 1 start
